# Environment reference. Secrets are passed as *_FILE references to files
# mounted from the secret store (OpenBao in staging/production).
APP_ENV=development
DATABASE_URL_FILE=/run/secrets/database_url
OCR_WORKER_URL=http://ocr-worker:8080
OCR_WORKER_TOKEN_FILE=/run/secrets/ocr_worker_token
OCR_WORKER_TIMEOUT_SECONDS=20
INBOUND_SERVICE_TOKENS_FILE=/run/secrets/inbound_service_tokens
ALLOWED_WORKLOADS=middleware-v3
DOCUMENT_HASH_PEPPER_FILE=/run/secrets/document_hash_pepper
SOURCE_LOOKUP_ALLOWED_HOSTS=
MAX_IMAGE_BYTES=8388608
MIN_IMAGE_DIMENSION=320
MAX_IMAGE_DIMENSION=8000
MAX_IMAGE_PIXELS=40000000
